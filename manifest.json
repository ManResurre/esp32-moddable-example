{
	"include": [
		"$(MODDABLE)/examples/manifest_base.json",
		"$(MODULES)/drivers/button/manifest.json",
		"$(MODULES)/pins/digital/manifest.json",
		"$(MODULES)/pins/servo/manifest.json",
		"$(MODULES)/network/http/manifest.json"
	],
	"modules": {
		"*": [
			"./main"
		]
	},
